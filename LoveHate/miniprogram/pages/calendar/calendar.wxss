.cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; padding: 0 16rpx; }
.nav-btn { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; background-color: var(--surface); border-radius: 50%; border: 1rpx solid var(--border); }
.nav-arrow { color: var(--text); font-size: var(--font-xl); font-weight: 700; }
.month-display { display: flex; flex-direction: column; align-items: center; }
.month-label { color: var(--text); font-size: var(--font-xl); font-weight: 800; letter-spacing: 2rpx; }

.report-trigger { display: flex; align-items: center; gap: 12rpx; background: linear-gradient(135deg, rgba(255,77,109,0.12), rgba(132,94,194,0.12)); padding: 24rpx 28rpx; border-radius: var(--radius-lg); border: 1rpx solid rgba(255,77,109,0.15); margin-bottom: 20rpx; }
.report-emoji { font-size: var(--font-lg); }
.report-text { flex: 1; color: var(--text); font-size: var(--font-md); font-weight: 700; }
.report-arrow { color: var(--text-muted); font-size: var(--font-lg); }

.cal-card { padding: 24rpx 16rpx; }
.weekday-row { display: flex; margin-bottom: 16rpx; }
.weekday-label { flex: 1; text-align: center; color: var(--text-muted); font-size: var(--font-xs); font-weight: 700; letter-spacing: 1rpx; }

.loading-wrap { display: flex; justify-content: center; padding: 60rpx 0; }
.loading-text { color: var(--text-muted); font-size: var(--font-sm); }

.week-row { display: flex; }
.day-cell { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 88rpx; border-radius: var(--radius-md); position: relative; transition: background-color 0.2s; }
.day-cell.has-record { background-color: rgba(255,255,255,0.03); }
.day-cell.today { background-color: rgba(255,77,109,0.1); }
.day-num { color: var(--text-secondary); font-size: var(--font-sm); font-weight: 600; }
.today-num { color: var(--love); font-weight: 800; }
.day-dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-top: 6rpx; }

.legend-row { display: flex; justify-content: center; gap: 40rpx; margin-top: 20rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.legend-text { color: var(--text-muted); font-size: var(--font-xs); }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--overlay); display: flex; align-items: center; justify-content: center; z-index: 999; }
.report-panel { background-color: var(--surface); border-radius: var(--radius-xxl); padding: 40rpx; width: 88%; max-width: 640rpx; border: 1rpx solid var(--border); box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.5); }
.report-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.report-title { color: var(--text); font-size: var(--font-lg); font-weight: 800; }
.report-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background-color: var(--surface-light); }
.close-icon { color: var(--text-secondary); font-size: var(--font-md); }

.report-body { text-align: center; }
.report-period { color: var(--text-muted); font-size: var(--font-sm); display: block; margin-bottom: 24rpx; }
.report-stats { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.rpt-stat-card { flex: 1; background-color: var(--surface-light); border-radius: var(--radius-lg); padding: 20rpx; text-align: center; border-top: 4rpx solid transparent; }
.rpt-stat-card.rpt-good { border-top-color: var(--success); }
.rpt-stat-card.rpt-bad { border-top-color: var(--hate); }
.rpt-stat-card.rpt-coins { border-top-color: var(--gold); }
.rpt-stat-emoji { font-size: 36rpx; display: block; }
.rpt-stat-num { display: block; font-size: var(--font-xxl); font-weight: 800; color: var(--text); margin-top: 4rpx; }
.rpt-stat-label { color: var(--text-muted); font-size: var(--font-xs); display: block; margin-top: 2rpx; }

.verdict-card { background: linear-gradient(135deg, rgba(255,77,109,0.1), rgba(132,94,194,0.1)); border-radius: var(--radius-lg); padding: 28rpx; border: 1rpx solid rgba(255,77,109,0.15); }
.verdict-text { color: var(--text); font-size: var(--font-md); font-weight: 600; line-height: 1.6; }
