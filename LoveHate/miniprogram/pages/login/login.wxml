<view class="page">
  <view class="hero">
    <view class="hero-glow"></view>
    <text class="brand"><text class="brand-love">Love</text><text class="brand-hate">Hate</text></text>
    <text class="tagline">爱恨情仇 · 情侣情绪博弈场</text>
  </view>

  <view class="mode-switch">
    <view class="mode-track">
      <view class="mode-indicator {{mode === 'sms' ? 'right' : ''}}"></view>
      <view class="mode-btn" data-mode="password" bindtap="switchMode">
        <text class="mode-btn-text {{mode === 'password' ? 'active' : ''}}">密码</text>
      </view>
      <view class="mode-btn" data-mode="sms" bindtap="switchMode">
        <text class="mode-btn-text {{mode === 'sms' ? 'active' : ''}}">短信</text>
      </view>
    </view>
  </view>

  <block wx:if="{{mode === 'sms'}}">
    <view class="form">
      <view class="input-wrap">
        <text class="input-icon">📱</text>
        <input class="input-field" placeholder="手机号" placeholder-class="placeholder" value="{{phone}}" bindinput="e => setData({phone: e.detail.value})" type="number" maxlength="11" />
      </view>
      <view class="sms-row">
        <view class="input-wrap flex-1">
          <text class="input-icon">🔐</text>
          <input class="input-field" placeholder="验证码" placeholder-class="placeholder" value="{{smsCode}}" bindinput="e => setData({smsCode: e.detail.value})" type="number" maxlength="6" />
        </view>
        <view class="sms-btn {{codeCooldown > 0 ? 'disabled' : ''}}" bindtap="codeCooldown > 0 ? '' : sendSms">
          <text class="sms-btn-text">{{codeCooldown > 0 ? codeCooldown + 's' : '获取验证码'}}</text>
        </view>
      </view>
      <view class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submitting ? '' : handleSubmit">
        <text class="btn-text">{{submitting ? '请稍候...' : '登录 ❤️'}}</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="tab-switch">
      <view class="tab-btn {{isLogin ? 'active' : ''}}" data-tab="login" bindtap="switchTab">
        <view class="tab-grad {{isLogin ? 'show' : ''}}" style="background: linear-gradient(135deg, var(--love), var(--love-light))"></view>
        <text class="tab-text {{isLogin ? 'active' : ''}}">登录</text>
      </view>
      <view class="tab-btn {{!isLogin ? 'active' : ''}}" data-tab="register" bindtap="switchTab">
        <view class="tab-grad {{!isLogin ? 'show' : ''}}" style="background: linear-gradient(135deg, var(--hate), var(--hate-light))"></view>
        <text class="tab-text {{!isLogin ? 'active' : ''}}">注册</text>
      </view>
    </view>

    <view class="form">
      <view class="input-wrap">
        <text class="input-icon">👤</text>
        <input class="input-field" placeholder="用户名" placeholder-class="placeholder" value="{{username}}" bindinput="e => setData({username: e.detail.value})" />
      </view>
      <view class="input-wrap" wx:if="{{!isLogin}}">
        <text class="input-icon">💕</text>
        <input class="input-field" placeholder="昵称（对方看到的名称）" placeholder-class="placeholder" value="{{nickname}}" bindinput="e => setData({nickname: e.detail.value})" />
      </view>
      <view class="input-wrap">
        <text class="input-icon">🔑</text>
        <input class="input-field" placeholder="密码" placeholder-class="placeholder" value="{{password}}" bindinput="e => setData({password: e.detail.value})" password />
      </view>
      <view class="btn-primary {{submitting ? 'disabled' : ''}}" wx:if="{{isLogin}}" bindtap="submitting ? '' : handleSubmit">
        <text class="btn-text">{{submitting ? '请稍候...' : '登录 ❤️'}}</text>
      </view>
      <view class="btn-hate {{submitting ? 'disabled' : ''}}" wx:else bindtap="submitting ? '' : handleSubmit">
        <text class="btn-text">{{submitting ? '请稍候...' : '注册 💜'}}</text>
      </view>
    </view>
  </block>
</view>
