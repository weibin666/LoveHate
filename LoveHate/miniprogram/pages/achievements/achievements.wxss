.summary-card {
  background: linear-gradient(135deg, var(--surface), rgba(255, 215, 0, 0.05));
  border: 1rpx solid rgba(255, 215, 0, 0.15);
}

.summary-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-icon {
  font-size: 56rpx;
}

.summary-info {
  flex: 1;
}

.summary-title {
  display: block;
  color: var(--text);
  font-size: var(--font-lg);
  font-weight: 800;
}

.summary-sub {
  display: block;
  color: var(--text-secondary);
  font-size: var(--font-sm);
  margin-top: 4rpx;
}

.summary-percent {
  color: var(--gold);
  font-size: var(--font-xxl);
  font-weight: 900;
}

.progress-bg {
  width: 100%;
  height: 16rpx;
  background-color: var(--surface-light);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--gold-deep), var(--gold));
  transition: width 1s ease;
}

.loading-state {
  text-align: center;
  padding: 80rpx 0;
}

.loading-text {
  color: var(--text-muted);
  font-size: var(--font-md);
}

.achievement-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.achievement-card {
  width: calc(50% - 8rpx);
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--border);
  text-align: center;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease both;
}

.achievement-card.unlocked {
  border-color: rgba(255, 215, 0, 0.2);
  background: linear-gradient(180deg, rgba(255, 215, 0, 0.06), var(--surface));
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.08);
}

.achievement-card.locked {
  opacity: 0.55;
}

.ach-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  background-color: var(--surface-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.ach-icon-wrap.glow {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(245, 158, 11, 0.1));
  box-shadow: 0 0 24rpx rgba(255, 215, 0, 0.25);
}

.ach-icon {
  font-size: 44rpx;
}

.ach-name {
  display: block;
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 700;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ach-name.dim {
  color: var(--text-muted);
}

.ach-desc {
  display: block;
  color: var(--text-secondary);
  font-size: var(--font-xs);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.ach-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 700;
}

.badge-lock {
  background-color: rgba(255, 255, 255, 0.04);
}

.badge-lock .ach-badge-text {
  color: var(--text-muted);
}

.ach-badge-text {
  font-size: 20rpx;
}
