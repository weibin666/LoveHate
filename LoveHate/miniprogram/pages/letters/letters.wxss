.header-banner {
  text-align: center;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(132, 94, 194, 0.15), rgba(255, 77, 109, 0.1));
  border-radius: var(--radius-xl);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}

.header-emoji {
  font-size: 72rpx;
  display: block;
}

.header-title {
  color: var(--text);
  font-size: var(--font-xl);
  font-weight: 800;
  display: block;
  margin-top: 8rpx;
}

.header-sub {
  color: var(--text-muted);
  font-size: var(--font-sm);
  display: block;
  margin-top: 4rpx;
}

.letter-card {
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 1rpx solid var(--border);
  margin-bottom: 16rpx;
  animation: fadeIn 0.4s ease;
  position: relative;
  overflow: hidden;
}

.letter-card.apology {
  border-left: 6rpx solid var(--hate);
}

.letter-card.apology::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--hate), transparent);
}

.letter-card.love {
  border-left: 6rpx solid var(--love);
}

.letter-card.love::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--love), transparent);
}

.letter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.letter-type-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
}

.letter-type-badge.apology {
  background-color: rgba(132, 94, 194, 0.15);
}

.letter-type-badge.love {
  background-color: rgba(255, 77, 109, 0.15);
}

.type-badge-text {
  font-size: var(--font-xs);
  font-weight: 700;
}

.letter-type-badge.apology .type-badge-text {
  color: var(--hate-light);
}

.letter-type-badge.love .type-badge-text {
  color: var(--love);
}

.letter-date {
  color: var(--text-muted);
  font-size: var(--font-xs);
}

.letter-sender {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.sender-label {
  color: var(--text-muted);
  font-size: var(--font-sm);
}

.sender-name {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 700;
}

.letter-content {
  color: var(--text);
  font-size: var(--font-md);
  line-height: 1.8;
  display: block;
  margin-bottom: 20rpx;
}

.letter-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: var(--radius-md);
}

.accept-btn {
  background: linear-gradient(135deg, var(--love), var(--love-light));
}

.reject-btn {
  background-color: var(--surface-light);
  border: 1rpx solid var(--border);
}

.action-btn-text {
  font-weight: 700;
  font-size: var(--font-md);
  color: white;
}

.reject-btn .action-btn-text {
  color: var(--text-secondary);
}

.letter-status {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.status-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-md);
}

.status-tag.accepted {
  background-color: rgba(255, 77, 109, 0.12);
}

.status-tag.rejected {
  background-color: rgba(156, 163, 175, 0.12);
}

.status-tag-text {
  font-size: var(--font-sm);
  font-weight: 700;
}

.status-tag.accepted .status-tag-text {
  color: var(--love);
}

.status-tag.rejected .status-tag-text {
  color: var(--text-muted);
}

.loading-card {
  text-align: center;
  padding: 64rpx;
}

.loading-text {
  color: var(--text-muted);
  font-size: var(--font-md);
}

.write-fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  border-radius: var(--radius-xxl);
  background: linear-gradient(135deg, var(--hate), var(--love));
  box-shadow: 0 8rpx 32rpx rgba(132, 94, 194, 0.3);
  z-index: 100;
}

.fab-icon {
  font-size: 32rpx;
}

.fab-label {
  color: white;
  font-size: var(--font-md);
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-content {
  background-color: var(--surface);
  border-top-left-radius: var(--radius-xxl);
  border-top-right-radius: var(--radius-xxl);
  padding: 36rpx;
  width: 100%;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--border);
  margin: 0 auto 20rpx;
}

.modal-title {
  color: var(--text);
  font-size: var(--font-xl);
  font-weight: 800;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
}

.type-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.type-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border);
  background-color: var(--surface-light);
  text-align: center;
  transition: all 0.3s ease;
}

.type-btn.love-active {
  border-color: var(--love);
  background-color: rgba(255, 77, 109, 0.1);
}

.type-btn.apology-active {
  border-color: var(--hate);
  background-color: rgba(132, 94, 194, 0.1);
}

.type-emoji {
  font-size: 40rpx;
  display: block;
}

.type-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
  font-weight: 600;
}

.template-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.template-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.template-chip {
  display: inline-block;
  padding: 16rpx 24rpx;
  background-color: var(--surface-light);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-xl);
  flex-shrink: 0;
}

.template-text {
  color: var(--text-secondary);
  font-size: var(--font-sm);
  white-space: nowrap;
}

.textarea {
  min-height: 180rpx;
  margin-bottom: 12rpx;
}

.modal-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.flex-1 {
  flex: 1;
}

.btn-inner-text {
  color: white;
  font-weight: 800;
  font-size: var(--font-md);
  text-align: center;
  display: block;
}

.cancel-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-md);
  text-align: center;
  border: 1rpx solid var(--border);
}

.cancel-text {
  color: var(--text-secondary);
  font-weight: 600;
}