.tab-bar {
  display: flex;
  background-color: var(--surface);
  border-radius: var(--radius-xl);
  padding: 6rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  transition: all 0.3s ease;
}

.tab.active {
  background: linear-gradient(135deg, var(--love), var(--hate));
}

.tab-text {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-secondary);
}

.tab.active .tab-text {
  color: white;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-sub {
  color: var(--text-muted);
  font-size: var(--font-sm);
  display: block;
  margin-top: 4rpx;
}

.items-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.item-card {
  width: calc(50% - 8rpx);
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1rpx solid var(--border);
  position: relative;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease;
}

.item-card.punishment {
  border-top: 4rpx solid var(--love);
}

.item-card.reward {
  border-top: 4rpx solid var(--love-light);
}

.item-type-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.item-type-badge.punishment-bg {
  background-color: rgba(255, 77, 109, 0.15);
}

.item-type-badge.reward-bg {
  background-color: rgba(255, 143, 163, 0.15);
}

.badge-inner {
  font-size: 28rpx;
}

.item-name {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 700;
  display: block;
  margin-bottom: 4rpx;
}

.item-desc {
  color: var(--text-muted);
  font-size: var(--font-xs);
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  color: var(--gold);
  font-size: var(--font-md);
  font-weight: 800;
}

.buy-btn {
  background: linear-gradient(135deg, var(--love), var(--love-deep));
  padding: 10rpx 24rpx;
  border-radius: var(--radius-md);
}

.buy-btn-reward {
  background: linear-gradient(135deg, var(--love-light), var(--love));
}

.buy-text {
  color: white;
  font-size: var(--font-sm);
  font-weight: 700;
}

.custom-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background-color: rgba(255, 215, 0, 0.12);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

.custom-tag-text {
  color: var(--gold);
  font-size: 18rpx;
  font-weight: 600;
}

.coupon-card {
  display: flex;
  align-items: center;
  background-color: var(--surface);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 1rpx solid var(--border);
  margin-bottom: 12rpx;
  animation: fadeIn 0.4s ease;
}

.coupon-card.used {
  opacity: 0.6;
}

.coupon-left {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background-color: rgba(255, 215, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.coupon-emoji {
  font-size: 36rpx;
}

.coupon-center {
  flex: 1;
}

.coupon-name {
  color: var(--text);
  font-size: var(--font-md);
  font-weight: 700;
  display: block;
}

.coupon-date {
  color: var(--text-muted);
  font-size: var(--font-xs);
  display: block;
  margin-top: 4rpx;
}

.coupon-status {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.coupon-status.pending {
  background-color: rgba(255, 215, 0, 0.12);
}

.coupon-status.used-status {
  background-color: rgba(156, 163, 175, 0.12);
}

.status-text {
  font-size: var(--font-xs);
  font-weight: 700;
}

.coupon-status.pending .status-text {
  color: var(--gold);
}

.coupon-status.used-status .status-text {
  color: var(--text-muted);
}

.loading-card {
  text-align: center;
  padding: 64rpx;
}

.loading-text {
  color: var(--text-muted);
  font-size: var(--font-md);
}

.create-fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--gold), var(--gold-deep));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 215, 0, 0.3);
  z-index: 100;
}

.fab-text {
  color: #0a0a14;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-content {
  background-color: var(--surface);
  border-top-left-radius: var(--radius-xxl);
  border-top-right-radius: var(--radius-xxl);
  padding: 36rpx;
  width: 100%;
  box-sizing: border-box;
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--border);
  margin: 0 auto 20rpx;
}

.modal-title {
  color: var(--text);
  font-size: var(--font-xl);
  font-weight: 800;
  text-align: center;
  display: block;
  margin-bottom: 20rpx;
}

.type-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.type-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border);
  background-color: var(--surface-light);
  text-align: center;
  transition: all 0.3s ease;
}

.type-btn.punishment-active {
  border-color: var(--love);
  background-color: rgba(255, 77, 109, 0.1);
}

.type-btn.reward-active {
  border-color: var(--love-light);
  background-color: rgba(255, 143, 163, 0.1);
}

.type-emoji {
  font-size: 40rpx;
  display: block;
}

.type-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
  font-weight: 600;
}

.textarea {
  min-height: 120rpx;
  margin-bottom: 12rpx;
}

.modal-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.flex-1 {
  flex: 1;
}

.btn-inner-text {
  color: white;
  font-weight: 800;
  font-size: var(--font-md);
  text-align: center;
  display: block;
}

.cancel-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-md);
  text-align: center;
  border: 1rpx solid var(--border);
}

.cancel-text {
  color: var(--text-secondary);
  font-weight: 600;
}