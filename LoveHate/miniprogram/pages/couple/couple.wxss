.hero-card { text-align: center; padding: 48rpx 0; position: relative; overflow: hidden; border-radius: var(--radius-xl); margin-bottom: 32rpx; }
.hero-glow { position: absolute; top: -120rpx; left: 50%; transform: translateX(-50%); width: 480rpx; height: 480rpx; border-radius: 50%; background: linear-gradient(135deg, var(--love), var(--hate)); opacity: 0.1; }
.hero-emoji { font-size: 120rpx; display: block; }
.hero-title { display: block; font-size: var(--font-xxl); font-weight: 800; color: var(--text); margin-top: 16rpx; }
.hero-sub { display: block; color: var(--text-secondary); font-size: var(--font-md); margin-top: 8rpx; }
.partner-name { color: var(--love); font-weight: 700; }
.card-title { font-size: var(--font-lg); font-weight: 700; color: var(--text); }
.card-title.center { text-align: center; }
.card-desc { color: var(--text-secondary); font-size: var(--font-sm); margin-top: 8rpx; margin-bottom: 24rpx; display: block; }
.btn-inner-text { color: white; font-weight: 800; font-size: var(--font-md); letter-spacing: 2rpx; }
.code-input { background-color: var(--surface-light); border-radius: var(--radius-md); border: 1rpx solid var(--border); padding: 28rpx; color: var(--text); font-size: var(--font-xl); text-align: center; letter-spacing: 12rpx; font-family: monospace; margin-bottom: 24rpx; }
.code-card { align-items: center; text-align: center; display: flex; flex-direction: column; }
.code-label { color: var(--text-muted); font-size: var(--font-xs); letter-spacing: 4rpx; }
.code-box { background: linear-gradient(135deg, var(--gold), var(--gold-deep)); border-radius: var(--radius-md); padding: 16rpx 48rpx; margin: 16rpx 0; }
.code-text { color: var(--bg); font-size: var(--font-xxl); font-weight: 900; letter-spacing: 16rpx; font-family: monospace; }
.code-hint { color: var(--text-muted); font-size: var(--font-xs); }
.divider-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background-color: var(--text-muted); }
.success-card { margin-bottom: 24rpx; }
