.notif-banner { background: linear-gradient(90deg, rgba(255,77,109,0.15), rgba(132,94,194,0.1)); border-radius: var(--radius-md); padding: 20rpx 28rpx; margin-bottom: 16rpx; border: 1rpx solid rgba(255,77,109,0.2); }
.notif-text { color: var(--text); font-size: var(--font-sm); font-weight: 600; }

.cold-war-banner { background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(99,102,241,0.1)); border-radius: var(--radius-lg); padding: 32rpx; text-align: center; margin-bottom: 20rpx; border: 1rpx solid rgba(99,102,241,0.2); }
.cw-emoji { font-size: 80rpx; display: block; }
.cw-title { display: block; color: #93c5fd; font-size: var(--font-lg); font-weight: 800; margin-top: 8rpx; }
.cw-desc { display: block; color: var(--text-muted); font-size: var(--font-sm); margin-top: 4rpx; }
.reconcile-btn { margin-top: 20rpx; display: inline-block; }
.btn-sm-text { color: white; font-weight: 700; font-size: var(--font-sm); }

.temp-card { text-align: center; }
.temp-emoji { font-size: 96rpx; }
.temp-label { color: var(--text-secondary); font-size: var(--font-xs); font-weight: 600; letter-spacing: 2rpx; }
.temp-row { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 8rpx; }
.temp-value { color: var(--text); font-size: var(--font-xxxl); font-weight: 900; }
.temp-tag { background-color: rgba(255,255,255,0.06); padding: 4rpx 12rpx; border-radius: var(--radius-sm); }
.temp-tag-text { color: var(--text-secondary); font-size: var(--font-xs); font-weight: 600; }
.temp-bar-bg { width: 100%; height: 12rpx; background-color: var(--surface-light); border-radius: 6rpx; margin-top: 20rpx; overflow: hidden; }
.temp-bar-fill { height: 100%; border-radius: 6rpx; transition: width 1.2s ease; }
.temp-range-row { display: flex; justify-content: space-between; width: 100%; margin-top: 8rpx; }
.temp-range { color: var(--text-muted); font-size: 20rpx; }

.stats-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.stat-card { flex: 1; background-color: var(--surface); border-radius: var(--radius-lg); padding: 20rpx; text-align: center; border: 1rpx solid var(--border); border-top-width: 4rpx; }
.stat-good { border-top-color: var(--success); }
.stat-grudge { border-top-color: var(--hate); }
.stat-coins { border-top-color: var(--gold); }
.stat-emoji { font-size: 36rpx; }
.stat-num { display: block; font-size: var(--font-xxl); font-weight: 800; margin-top: 4rpx; }
.stat-num.good { color: var(--success); }
.stat-num.hate { color: var(--hate-light); }
.stat-num.gold { color: var(--gold); }
.stat-label { color: var(--text-muted); font-size: var(--font-xs); margin-top: 2rpx; display: block; }

.action-row { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.action-btn { flex: 1; border-radius: var(--radius-md); padding: 28rpx; text-align: center; }
.action-btn.good { background: linear-gradient(135deg, var(--love), var(--love-light)); }
.action-btn.grudge { background: linear-gradient(135deg, var(--hate), var(--hate-light)); }
.action-text { color: white; font-size: var(--font-lg); font-weight: 800; }

.record-card { background-color: var(--surface); border-radius: var(--radius-lg); padding: 24rpx; border: 1rpx solid var(--border); border-left-width: 6rpx; margin-bottom: 16rpx; }
.record-card.good { border-left-color: var(--success); }
.record-card.grudge { border-left-color: var(--hate); }
.record-header { display: flex; align-items: center; gap: 12rpx; }
.emoji-badge { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0; }
.emoji-badge.good-bg { background-color: rgba(74,222,128,0.15); }
.emoji-badge.hate-bg { background-color: rgba(132,94,194,0.15); }
.record-meta { flex: 1; }
.meta-name { color: var(--text-secondary); font-size: var(--font-sm); font-weight: 600; display: block; }
.meta-date { color: var(--text-muted); font-size: var(--font-xs); display: block; }
.coin-badge { padding: 4rpx 12rpx; border-radius: var(--radius-sm); }
.coin-badge.gold-bg { background-color: rgba(255,215,0,0.12); }
.coin-badge.error-bg { background-color: rgba(248,113,113,0.12); }
.coin-text { font-size: var(--font-xs); font-weight: 700; }
.coin-text.gold { color: var(--gold); }
.coin-text.error { color: var(--error); }
.record-content { color: var(--text); margin-top: 12rpx; font-size: var(--font-md); line-height: 1.6; }
.renew-btn { margin-top: 12rpx; display: inline-block; background-color: rgba(132,94,194,0.12); padding: 8rpx 20rpx; border-radius: var(--radius-md); border: 1rpx solid rgba(132,94,194,0.25); }
.renew-text { color: var(--hate-light); font-size: var(--font-xs); font-weight: 700; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--overlay); display: flex; align-items: flex-end; z-index: 999; }
.modal-content { background-color: var(--surface); border-top-left-radius: var(--radius-xxl); border-top-right-radius: var(--radius-xxl); padding: 36rpx; width: 100%; box-sizing: border-box; }
.modal-handle { width: 80rpx; height: 8rpx; border-radius: 4rpx; background-color: var(--border); margin: 0 auto 20rpx; }
.modal-title { color: var(--text); font-size: var(--font-xl); font-weight: 800; text-align: center; display: block; margin-bottom: 20rpx; }
.emotion-grid { display: flex; gap: 12rpx; justify-content: center; margin-bottom: 20rpx; }
.emotion-btn { padding: 20rpx; border-radius: var(--radius-md); border: 1rpx solid var(--border); background-color: var(--surface-light); text-align: center; min-width: 120rpx; }
.emotion-btn.good-active { border-color: var(--success); background-color: rgba(74,222,128,0.1); }
.emotion-btn.hate-active { border-color: var(--hate); background-color: rgba(132,94,194,0.1); }
.emo-emoji { font-size: 48rpx; display: block; }
.emo-label { font-size: 20rpx; color: var(--text-secondary); margin-top: 4rpx; display: block; }
.textarea { min-height: 180rpx; margin-bottom: 12rpx; }
.image-row { display: flex; gap: 16rpx; align-items: center; margin-bottom: 12rpx; }
.image-btn { border: 1rpx solid var(--border); border-radius: var(--radius-md); padding: 12rpx 20rpx; }
.image-btn-text { color: var(--text-secondary); font-size: var(--font-sm); }
.remove-text { color: var(--error); font-size: var(--font-sm); }
.modal-btn-row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.flex-1 { flex: 1; }
.btn-inner-text { color: white; font-weight: 800; font-size: var(--font-md); text-align: center; display: block; }
.cancel-btn { flex: 1; padding: 24rpx; border-radius: var(--radius-md); text-align: center; border: 1rpx solid var(--border); }
.cancel-text { color: var(--text-secondary); font-weight: 600; }
