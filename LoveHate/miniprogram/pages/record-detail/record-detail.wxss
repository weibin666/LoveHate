.detail-card { background-color: var(--surface); border-radius: var(--radius-lg); padding: 32rpx; border: 1rpx solid var(--border); }
.detail-header { display: flex; align-items: center; gap: 16rpx; }
.emoji-badge { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.emoji-badge.good-bg { background-color: rgba(74,222,128,0.15); }
.emoji-badge.hate-bg { background-color: rgba(132,94,194,0.15); }
.emoji-text { font-size: 36rpx; }
.meta { flex: 1; }
.meta-name { color: var(--text-secondary); font-size: var(--font-sm); font-weight: 600; display: block; }
.meta-date { color: var(--text-muted); font-size: var(--font-xs); display: block; }
.coin-badge { padding: 6rpx 16rpx; border-radius: var(--radius-sm); }
.coin-badge.gold-bg { background-color: rgba(255,215,0,0.12); }
.coin-badge.error-bg { background-color: rgba(248,113,113,0.12); }
.coin-text { font-size: var(--font-xs); font-weight: 700; }
.coin-text.gold { color: var(--gold); }
.coin-text.error { color: var(--error); }
.detail-content { color: var(--text); font-size: var(--font-lg); line-height: 1.7; margin-top: 24rpx; }
.detail-image { width: 100%; border-radius: var(--radius-md); margin-top: 20rpx; }
.action-row { margin-top: 24rpx; display: flex; }
.flex-1 { flex: 1; }
.btn-inner-text { color: white; font-weight: 800; text-align: center; display: block; }
.delete-btn { flex: 1; padding: 24rpx; border-radius: var(--radius-md); text-align: center; border: 1rpx solid rgba(248,113,113,0.2); }
.delete-text { color: var(--error); font-weight: 700; }
