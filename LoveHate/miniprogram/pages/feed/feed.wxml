<view class="container">
  <view class="header-bar">
    <text class="page-title">💬 情侣空间</text>
    <view class="create-btn" bindtap="openForm">
      <text class="create-btn-text">✏️ 发动态</text>
    </view>
  </view>

  <view wx:if="{{posts.length === 0}}" class="empty-card">
    <text class="emoji">💌</text>
    <text class="text">还没有动态，快来分享你的心情吧</text>
  </view>

  <view wx:for="{{posts}}" wx:key="id" class="post-card">
    <view class="post-header">
      <view class="avatar" style="background: {{item.isMine ? 'linear-gradient(135deg, var(--love), var(--love-light))' : 'linear-gradient(135deg, var(--hate), var(--hate-light))'}};">
        <text class="avatar-text">{{item.author_nickname[0] || '?'}}</text>
      </view>
      <view class="post-meta">
        <text class="author-name">{{item.author_nickname}}</text>
        <text class="post-time">{{item.timeText}}</text>
      </view>
      <view wx:if="{{item.moodObj}}" class="mood-badge">
        <text class="mood-text">{{item.moodObj.emoji}} {{item.moodObj.label}}</text>
      </view>
      <view wx:if="{{item.isMine}}" class="delete-btn" catchtap="handleDelete" data-id="{{item.id}}">
        <text class="delete-icon">×</text>
      </view>
    </view>

    <text class="post-content">{{item.content}}</text>

    <view wx:if="{{item.image_url}}" class="post-image-wrap" bindtap="previewImage" data-url="{{item.image_url}}">
      <image class="post-image" src="{{item.image_url}}" mode="aspectFill" />
    </view>

    <view class="post-actions">
      <view class="like-btn {{item.liked ? 'liked' : ''}}" bindtap="handleLike" data-id="{{item.id}}">
        <text class="like-icon">{{item.liked ? '❤️' : '🤍'}}</text>
        <text class="like-count">{{item.likes || 0}}</text>
      </view>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showForm}}" bindtap="closeForm">
  <view class="modal-content" catchtap="">
    <view class="modal-handle"></view>
    <text class="modal-title">✏️ 发动态</text>

    <text class="section-label">选择心情</text>
    <view class="mood-grid">
      <view wx:for="{{moods}}" wx:key="value"
        class="mood-btn {{mood === item.value ? 'mood-active' : ''}}"
        bindtap="selectMood" data-value="{{item.value}}">
        <text class="mood-emoji">{{item.emoji}}</text>
        <text class="mood-label">{{item.label}}</text>
      </view>
    </view>

    <textarea class="input textarea" placeholder="分享你的心情..."
      placeholder-class="placeholder" value="{{content}}" bindinput="handleInput" auto-height maxlength="500" />

    <view class="image-row">
      <view class="image-btn" bindtap="pickImage">
        <text class="image-btn-text">{{imageUri ? '📷 已选择图片' : '📷 添加图片'}}</text>
      </view>
      <view wx:if="{{imageUri}}" bindtap="removeImage">
        <text class="remove-text">✕ 移除</text>
      </view>
    </view>

    <view class="modal-btn-row">
      <view class="btn-primary flex-1 {{submitting ? 'disabled' : ''}}" bindtap="submitting ? '' : handleSubmit">
        <text class="btn-inner-text">{{submitting ? '发布中...' : '发布'}}</text>
      </view>
      <view class="cancel-btn" bindtap="closeForm">
        <text class="cancel-text">取消</text>
      </view>
    </view>
  </view>
</view>
