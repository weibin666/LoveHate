.header-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.page-title { color: var(--text); font-size: var(--font-xl); font-weight: 800; }
.create-btn { background: linear-gradient(135deg, var(--love), var(--love-light)); padding: 16rpx 28rpx; border-radius: var(--radius-xl); }
.create-btn-text { color: white; font-size: var(--font-sm); font-weight: 700; }

.post-card { background-color: var(--surface); border-radius: var(--radius-lg); padding: 28rpx; border: 1rpx solid var(--border); margin-bottom: 20rpx; animation: fadeIn 0.3s ease; }
.post-header { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar-text { color: white; font-size: var(--font-lg); font-weight: 800; }
.post-meta { flex: 1; }
.author-name { color: var(--text); font-size: var(--font-md); font-weight: 700; display: block; }
.post-time { color: var(--text-muted); font-size: var(--font-xs); display: block; margin-top: 2rpx; }
.mood-badge { background-color: rgba(255,255,255,0.06); padding: 6rpx 16rpx; border-radius: var(--radius-sm); }
.mood-text { color: var(--text-secondary); font-size: var(--font-xs); font-weight: 600; }
.delete-btn { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background-color: rgba(248,113,113,0.1); }
.delete-icon { color: var(--error); font-size: var(--font-lg); font-weight: 700; }

.post-content { color: var(--text); font-size: var(--font-md); line-height: 1.7; margin-top: 16rpx; word-break: break-all; }

.post-image-wrap { margin-top: 16rpx; border-radius: var(--radius-md); overflow: hidden; }
.post-image { width: 100%; height: 360rpx; border-radius: var(--radius-md); }

.post-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); }
.like-btn { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; border-radius: var(--radius-xl); background-color: var(--surface-light); transition: all 0.2s; }
.like-btn.liked { background-color: rgba(255,77,109,0.15); }
.like-icon { font-size: var(--font-md); }
.like-count { color: var(--text-secondary); font-size: var(--font-sm); font-weight: 600; }

.mood-grid { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: center; margin-bottom: 20rpx; }
.mood-btn { padding: 16rpx 20rpx; border-radius: var(--radius-md); border: 1rpx solid var(--border); background-color: var(--surface-light); text-align: center; min-width: 100rpx; transition: all 0.2s; }
.mood-btn.mood-active { border-color: var(--love); background-color: rgba(255,77,109,0.12); }
.mood-emoji { font-size: 40rpx; display: block; }
.mood-label { font-size: 20rpx; color: var(--text-secondary); margin-top: 4rpx; display: block; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--overlay); display: flex; align-items: flex-end; z-index: 999; }
.modal-content { background-color: var(--surface); border-top-left-radius: var(--radius-xxl); border-top-right-radius: var(--radius-xxl); padding: 36rpx; width: 100%; box-sizing: border-box; }
.modal-handle { width: 80rpx; height: 8rpx; border-radius: 4rpx; background-color: var(--border); margin: 0 auto 20rpx; }
.modal-title { color: var(--text); font-size: var(--font-xl); font-weight: 800; text-align: center; display: block; margin-bottom: 20rpx; }
.textarea { min-height: 180rpx; margin-bottom: 12rpx; }
.image-row { display: flex; gap: 16rpx; align-items: center; margin-bottom: 12rpx; }
.image-btn { border: 1rpx solid var(--border); border-radius: var(--radius-md); padding: 12rpx 20rpx; }
.image-btn-text { color: var(--text-secondary); font-size: var(--font-sm); }
.remove-text { color: var(--error); font-size: var(--font-sm); }
.modal-btn-row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.flex-1 { flex: 1; }
.btn-inner-text { color: white; font-weight: 800; font-size: var(--font-md); text-align: center; display: block; }
.cancel-btn { flex: 1; padding: 24rpx; border-radius: var(--radius-md); text-align: center; border: 1rpx solid var(--border); }
.cancel-text { color: var(--text-secondary); font-weight: 600; }
